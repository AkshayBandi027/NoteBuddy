# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Neon (or any Postgres) connection string. pgvector must be available.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Secret used by better-auth to sign sessions. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app. Used by better-auth for trusted origins.
BETTER_AUTH_URL=http://localhost:3000

# Google AI Studio key, used for text embeddings (gemini-embedding-001).
GOOGLE_GENAI_KEY=

# OpenRouter key, used for autocomplete and summarization.
OPEN_ROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Base URL used by the browser auth client. Defaults to the current origin.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Override the AI models if needed.
OPENROUTER_MODEL=google/gemma-3-27b-it:free
EMBEDDING_MODEL=gemini-embedding-001

# Google OAuth is optional. The Google buttons only render when BOTH values
# are set. Leave empty to use email/password auth only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
